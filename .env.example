# Neon Postgres, runtime: the restricted atelier_app role (see CLAUDE.md → Database)
DATABASE_URL="postgresql://atelier_app:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon Postgres, migrations and seed: the owner role (neondb_owner). Never used by the app.
DATABASE_MIGRATION_URL="postgresql://neondb_owner:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL (used by the auth client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
